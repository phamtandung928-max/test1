local function readPing()
    local ok, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)

    if ok and type(ping) == "number" then
        return math.floor(ping + 0.5)
    end

    return nil
end

local frames = 0
local elapsed = 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1
    elapsed += dt

    if elapsed >= 1 then
        local fps = math.floor(frames / elapsed + 0.5)
        local ping = readPing()

        hudText.Text = "FPS: " .. fps
            .. " | MS: " .. (ping and tostring(ping) or "--")

        if fps >= 55 then
            hudText.TextColor3 = Color3.fromRGB(80, 235, 160)
        elseif fps >= 30 then
            hudText.TextColor3 = Color3.fromRGB(255, 205, 75)
        else
            hudText.TextColor3 = Color3.fromRGB(255, 90, 100)
        end

        frames = 0
        elapsed = 0
    end
end)

