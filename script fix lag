--==================================================
-- FIX LAG THEO CO CHE V13
--==================================================

local fixEnabled = false
local savedParts = {}
local oldShadows = nil
local grayEffect = nil
local descendantConnection = nil

local function shouldSkip(part)
    local character = player.Character

    if character and part:IsDescendantOf(character) then
        return true
    end

    if part:GetAttribute("KeepOriginal") == true then
        return true
    end

    local name = string.lower(part.Name)
    local skipNames = {
        "ground", "floor", "baseplate",
        "wall", "terrain"
    }

    for _, word in ipairs(skipNames) do
        if string.find(name, word, 1, true) then
            return true
        end
    end

    return false
end

local function optimizePart(part)
    if not part:IsA("BasePart") then
        return
    end

    if shouldSkip(part) or savedParts[part] then
        return
    end

    savedParts[part] = {
        Color = part.Color,
        Material = part.Material,
        LocalTransparencyModifier = part.LocalTransparencyModifier
    }

    pcall(function()
        part.Color = Color3.fromRGB(150, 150, 150)
        part.Material = Enum.Material.SmoothPlastic
        part.LocalTransparencyModifier = 0.35
    end)
end

local function enableFixLag()
    if fixEnabled then
        return
    end

    fixEnabled = true
    oldShadows = Lighting.GlobalShadows

    for _, object in ipairs(Workspace:GetDescendants()) do
        optimizePart(object)
    end

    Lighting.GlobalShadows = false

    grayEffect = Instance.new("ColorCorrectionEffect")
    grayEffect.Name = "TanDungGrayEffect"
    grayEffect.Saturation = -0.55
    grayEffect.Parent = Lighting

    descendantConnection = Workspace.DescendantAdded:Connect(function(object)
        if fixEnabled then
            task.defer(function()
                if fixEnabled and object.Parent then
                    optimizePart(object)
                end
            end)
        end
    end)

    fixButton.Text = "FIX LAG: ON"
    fixButton.BackgroundColor3 = Color3.fromRGB(25, 135, 85)
    status.Text = "Trạng thái: Đã bật FIX LAG"
end

local function disableFixLag()
    if not fixEnabled then
        return
    end

    fixEnabled = false

    if descendantConnection then
        descendantConnection:Disconnect()
        descendantConnection = nil
    end

    for part, properties in pairs(savedParts) do
        if part and part.Parent then
            pcall(function()
                part.Color = properties.Color
                part.Material = properties.Material
                part.LocalTransparencyModifier =
                    properties.LocalTransparencyModifier
            end)
        end
    end

    table.clear(savedParts)

    if grayEffect then
        grayEffect:Destroy()
        grayEffect = nil
    end

    if oldShadows ~= nil then
        Lighting.GlobalShadows = oldShadows
        oldShadows = nil
    end

    fixButton.Text = "FIX LAG: OFF"
    fixButton.BackgroundColor3 = Color3.fromRGB(35, 55, 80)
    status.Text = "Trạng thái: Đã tắt FIX LAG"
end

fixButton.Activated:Connect(function()
    if fixEnabled then
        disableFixLag()
    else
        enableFixLag()
    end
end)

