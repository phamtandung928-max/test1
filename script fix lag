-- TOI UU FPS
-- Ha chat luong render neu Roblox cho phep
--==================================================

local fpsOptimized = false
local previousQuality = nil

fpsButton.Activated:Connect(function()
    if not fpsOptimized then
        local ok, oldQuality = pcall(function()
            return settings().Rendering.QualityLevel
        end)

        if ok then
            previousQuality = oldQuality
        end

        local setOK = pcall(function()
            settings().Rendering.QualityLevel =
                Enum.QualityLevel.Level01
        end)

        fpsOptimized = true
        fpsButton.Text = "FPS TỐI ƯU: ON"
        fpsButton.BackgroundColor3 = Color3.fromRGB(25, 135, 85)

        if setOK then
            status.Text = "Đã yêu cầu giảm chất lượng đồ họa"
        else
            status.Text = "Không thể chỉnh QualityLevel ở phiên này"
        end
    else
        if previousQuality ~= nil then
            pcall(function()
                settings().Rendering.QualityLevel = previousQuality
            end)
        end

        previousQuality = nil
        fpsOptimized = false
        fpsButton.Text = "TỐI ƯU FPS"
        fpsButton.BackgroundColor3 = Color3.fromRGB(25, 105, 145)
        status.Text = "Đã tắt chế độ tối ưu FPS"
    end
end)

